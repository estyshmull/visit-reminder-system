# Backend - Development environment variables
# הערות: קובץ זה מיועד לפיתוח מקומי בלבד. אל תשתמשו בו לפרודקשן.

# Database connection string
DATABASE_URL="mysql://dev_user:dev_password@127.0.0.1:3306/visit_reminders_dev"

# JWT settings
JWT_SECRET="dev_jwt_secret_change_me"
JWT_EXPIRES_IN="7d"

# Server
NODE_ENV="development"

# Frontend origin - used for CORS during development
FRONTEND_URL="http://localhost:5173"

# Webhook / public URL used by external services in dev (ngrok, localtunnel)
SERVER_URL="http://localhost:3000"

# Feature toggles
ENABLE_REMINDERS=false

# Logging and debug
LOG_LEVEL="debug"

# ===== Yemot HaMashiach API Integration =====
# מערכת ימות המשיח לשליחת שיחות קוליות
# 
# 🔑 הכנס כאן את הטוקן שלך מימות המשיח:
YEMOT_TOKEN="WU1BUElL.apik_zuBc9U1fQxxdoSGksSubeg.5rzu64_UHAahaDqawpSJCjx1SO5On9a2x4gEyvTh0ic"
# 
# כתובת ה-API (לא לשנות אלא אם כן יש הוראה אחרת)
YEMOT_API_BASE="https://www.call2all.co.il/ym/api"

# הערות נוספות:
# - אל תשמור סודות אמיתיים בקוד. השתמש בקבצי סודות או secret manager לפרודקשן.
# - אם יש צורך להתחבר לשירותי צד שלישי אמיתיים, עדכן את הערכים בהתאם.
